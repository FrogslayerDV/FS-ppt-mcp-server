# Azure Configuration
location            = "eastus"
resource_group_name = "rg-ppt-mcp"
environment_name    = "prod"

# GitHub Configuration
github_username = "your-github-username"
# github_token is provided via environment variable or command line

# Container Configuration
container_image = "ghcr.io/your-github-username/ppt-mcp-server:latest"
containers_file = "container-definitions.yml"

# Additional Tags
tags = {
  Owner       = "your-name"
  Cost-Center = "development"
  Department  = "engineering"
}